{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "aliyuncs/oss-sdk-php": "^2.6",
        "anthropic-ai/sdk": "^1.3",
        "codingyu/laravel-ueditor": "2.0.3",
        "codingyu/ueditor": "^3.0",
        "danielme85/laravel-geoip2": "^1.2",
        "doctrine/dbal": "^3.5",
        "encore/laravel-admin": "^1.8.19",
        "fenguoz/bsc-php": "^2.3",
        "fenguoz/tron-php": "^2.1",
        "geoip2/geoip2": "^2.13",
        "godruoyi/php-snowflake": "^1.0",
        "google/cloud-translate": "v1.15.0",
        "gregwar/captcha": "^1.1",
        "guzzlehttp/guzzle": "^7.2",
        "hedeqiang/umeng": "^1.0",
        "jaeger/querylist": "^4.4",
        "jxlwqq/simditor": "^1.0",
        "laravel-admin-ext/china-distpicker": "^1.4",
        "laravel-admin-ext/grid-lightbox": "^1.0",
        "laravel-admin-ext/media-manager": "2.0.4",
        "laravel-admin-ext/media-player": "^1.1",
        "laravel-admin-ext/summernote": "^1.0",
        "laravel-notification-channels/webpush": "^7.1",
        "laravel/framework": "^10.48",
        "laravel/tinker": "^2.8",
        "maatwebsite/excel": "^3.1.48",
        "overtrue/easy-sms": "^1.3",
        "predis/predis": "^2.0",
        "spatie/laravel-short-schedule": "^1.5",
        "tymon/jwt-auth": "^2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/laravel-ueditor",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "packages/media-manager",
            "options": {
                "symlink": false
            }
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-fwvh-pm3c-1m7b": "encore/laravel-admin 任意文件上传：所有版本(<=1.8.19)均受影响且无修复版本，线上原版本 1.8.11 同样受影响；后台另行做访问防护，长期计划迁移后台框架",
                    "PKSA-j43q-24zh-tyzv": "mdanter/ecc 时序侧信道：由 fenguoz/tron-php -> fenguoz/tron-api -> kornrunner/secp256k1 0.2 间接依赖，暂无可替换版本，线上原版本 0.5.2 同样受影响",
                    "PKSA-36gf-zqdd-tq5m": "mdanter/ecc 加密侧信道：同上，等待上游 Tron 库更新到 paragonie/ecc 后移除"
                }
            }
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "files": [
            "bootstrap/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
