APP_NAME=TrxFund.io
ADMIN_NAME=TrxFund.io
APP_ENV=true
APP_KEY=
APP_DEBUG=true
APP_URL=http://fishall.st:20080
#ADMIN_DOMAIN=https://nfrdifishapi.ceshi.in
ADMIN_HTTPS=false
LOG_CHANNEL=stack
LOCALE_LIST=en,zh-CN,vi
#默认语言
API_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trxfund
DB_USERNAME=
DB_PASSWORD=

#默认 php artisan queue:work --queue=trxfund --timeout=300
#余额查询归集等 php artisan queue:work --queue=trxfundlow --timeout=300
#订单结算 php artisan queue:work --queue=trxfundfast --timeout=300
#sudo -u www bash -c 'php /www/wwwroot/ifund/api/artisan schedule:run >> /dev/null 2>&1'
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE=trxfund
REDIS_QUEUE_LOW=trxfundlow
REDIS_QUEUE_FAST=trxfundfast
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PREFIX=trxfund
REDIS_CLIENT=predis
REDIS_DB=1

#php artisan geoip:download
#php artisan vendor:publish --provider="danielme85\Geoip2\Geoip2ServiceProvider"
GEOIP2_LICENSE=
GOOGLE_TRANSLATE_KEY=


