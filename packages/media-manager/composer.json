{
    "name": "laravel-admin-ext/media-manager",
    "description": "Media manager for laravel (Local copy of laravel-admin-ext/media-manager 2.0.3, adapted for Laravel 10 / Flysystem 3)",
    "version": "2.0.4",
    "type": "library",
    "keywords": ["laravel-admin", "media", "manager"],
    "homepage": "https://github.com/laravel-admin-extensions/media-manager",
    "license": "MIT",
    "authors": [
        {
            "name": "z-song",
            "email": "zosong@126.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "encore/laravel-admin": "~1.6",
        "league/flysystem": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Encore\Admin\Media\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Encore\Admin\Media\MediaServiceProvider"
            ]
        }
    }
}
